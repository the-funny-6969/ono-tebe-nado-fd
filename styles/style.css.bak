/* место для вашего кода */
a {
	height: 100%;
}
article {
	height: 100%;
}

.header {
    display: grid;
    grid-template-columns: 1fr min-content 1fr;
    align-items: center;
    padding: 92px 50px 92px;
}

.header__address {
    justify-self: end;
}

.address {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
    max-width: 240px;
    font-size: 18px;
    font-style: normal;
    line-height: 1.35;
}

.header__menu-list {
	display: flex;
	font-size: 18px;
	gap: 33px;
	list-style: circle;
	padding: 0;
}

.menu-item {
	font-size: 18px;
}

.menu-item:first-child {
	list-style: none;
}

.logo-link {
  display: block;
  width: 136px;
  height: auto;
} 

.bg-image {
	display: flex;
	flex-direction: column;
	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;
	position: relative;
	color: white;
	justify-content: space-between;
	text-transform: uppercase;
}

.cover {
	background-image: url(../images/cover.jpg);
	min-height: 757px;
	padding: 165px 50px 50px 50px;
}

.overlay {
	background-color: rgb(0 0 0 / 0.6);
	position: absolute;
	width: 100%;
	height: 100%;
	z-index: 1;
	inset: 0;
}

.cover__title {
	z-index: 2;
	position: relative;
	font-size: 100px;
	text-transform: uppercase;
	letter-spacing: 0.3em;
}

.last-letter {
	letter-spacing: 0;
}

.aligned-text {
	display: flex;
}
.aligned-text_left {
    justify-self: start;
}
.aligned-text_center {
    justify-self: center;
	margin-top: 17px;
}
.aligned-text_right {
    justify-self: end;
}


.description {
	display: flex;
	z-index: 2;
	font-size: 22px;
	position: relative;
	justify-content: space-between;
	word-spacing: 18.5px;
	align-items: center;
	
}

.bet-button {
	background: transparent;
	border: 1px solid white;
	cursor: pointer;
	text-transform: uppercase;
	padding: 11px 31px;
	color: white;
}


.lots {
	margin-top: 180px;
	margin-bottom: 120px;
	padding-left: 24px;
	padding-right: 24px;
}

.lots__heading {
	margin-left: 40px;
	margin-bottom: 27px;
	text-transform: uppercase;
	font-size: 40px;
}

.lots-list {

	list-style: none;
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap: 25px;
}

.lots-item {
	display: flex;
	padding: 48px 40px;
	min-height: 596px;
}

.lots-article {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

.lots-item:first-of-type {
  background-image: url(../images/card-lot-01.jpg);
} 

.lots-item:nth-of-type(2) {
  background-image: url(../images/card-lot-02.jpg);
} 

.lots-item:nth-of-type(3) {
  background-image: url(../images/card-lot-03.jpg);
}

.lots-item__heading {
	z-index: 2;
	text-decoration: underline;
	font-size: 22px;
	font-weight: bold;
	position: relative;
}

.lots-item__description {
	z-index: 2;
	text-transform: none;
	font-size: 20px;
	position: relative;
}

.see-more {
	display: block;
	margin-top: 30px;
	margin-left: 40px;
	font-size: 20px;
}

.about {
	display: grid;
	grid-template-columns: 334px 1fr;
	gap: 25px;
	padding-top: 35px;
	margin-left: 24px;
	margin-right: 24px;
	min-height: 595px;
	margin-bottom: 180px;
}

.about-column__logo {
	display: flex;
	justify-content: center;
}

.about-logo__bg {
	display: flex;
	width: 240px;
	height: 240px;
	border-radius: 50%;
	background-color: black;
	align-items: center;
	justify-content: center;
}
.about-logo {
	width: 148px;
	height: 114px;
}

.about-column__desc {
	display: flex;
	flex-direction: column;
}

.about-desc__heading {
	margin-top: 101px;
	margin-bottom: 100px;
	text-transform: uppercase;
	font-size: 40px;

}

.about-desc__text {
	display: grid;
	gap: 24px;
	font-size: 20px;
}

.footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-left: 50px;
	padding-right: 50px;
	margin-bottom: 82px;
}

.footer__menu-list {
	justify-self: center;
	text-align: center;
	list-style: none;
	padding: 0;
}

.footer__address {
    justify-self: start;
}

.footer__social-list {
	display: flex;
	gap: 48px;
	list-style: none;
	justify-self: end;
}
.footer__social-icon {
	display: block;
	width: 48px;
	height: auto;
}